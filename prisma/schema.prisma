// PaaniPulse data model. PostgreSQL (Neon in production, any Postgres locally).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Neon: the "-pooler" host)
  directUrl = env("DIRECT_URL") // direct connection for migrations (can be the same URL locally)
}

/// Account. Farmers sign in with phone + PIN; installers and authorities with email + password.
model User {
  id             String               @id @default(cuid())
  role           String // FARMER | INSTALLER | AUTHORITY
  name           String
  phone          String?              @unique
  email          String?              @unique
  passwordHash   String
  organisation   String?
  createdAt      DateTime             @default(now())
  farms          Farm[]               @relation("FarmOwner")
  installedFarms Farm[]               @relation("FarmInstaller")
  resetTokens    PasswordResetToken[]
  /// Farmer opted in to the daily advice (and pump over-run alerts) by SMS / WhatsApp.
  smsAdvice      Boolean              @default(false)
}

/// One-time password reset link (email accounts). Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Wrong guesses against SMS/WhatsApp codes (locks the code after 5).
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
}

/// Field check of the virtual meter: a real drum/bucket measurement vs the app's prediction.
model FieldCheck {
  id           String   @id @default(cuid())
  farmId       String
  farm         Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  takenAt      DateTime @default(now())
  hour         Int
  volumeL      Float
  seconds      Float
  inverterKw   Float?
  measuredLph  Float
  predictedLph Float
  powerSource  String // inverter | sunlight
  errorPct     Float
  calibrated   Boolean // was the meter calibrated when this check was taken
  note         String?
}

/// Last good Open-Meteo response per ~11 km cell (survives serverless cold starts).
model WeatherCache {
  key       String   @id
  json      String
  fetchedAt DateTime
}

/// Neural TTS audio, keyed by sha1(voice|text).
model AudioCache {
  id        String   @id
  mp3       Bytes
  createdAt DateTime @default(now())
}

model Farm {
  id               String        @id @default(cuid())
  farmerName       String
  /// A name the farmer gives this farm ("North field"), so several farms in one account can be told apart.
  nickname         String?
  phone            String?
  language         String        @default("ur") // "ur" | "en"
  lat              Float
  lng              Float
  district         String
  tehsil           String?
  cropType         String // wheat | rice | maize | cotton | sugarcane
  sowingDate       DateTime
  areaAcres        Float
  /// "sand" | "sandy-loam" | "loam" | "clay": sets how much water the soil holds. Default loam = the earlier fixed value.
  soilType         String        @default("loam")
  /// The seed variety the farmer knows (free text, e.g. "Galaxy-2013"). Recorded for the installer and the pilot; it does not change the maths.
  variety          String?
  /// "normal" | "early" | "late": a shorter- or longer-duration variety. Stretches the growth stages by 10% (a rough assumption).
  maturity         String        @default("normal")
  /// How the farmer thinks of his land: "acre" | "kanal" | "marla" | "murabba" | "ghumaon". areaAcres stays the stored value.
  areaUnit         String        @default("acre")
  /// Fertiliser rate the farmer or installer entered from a soil test or agriculture officer (not a recommendation by the app).
  fertPlan         Json?
  /// When the last "enough water has reached the probe" SMS was sent (at most one every few hours).
  lastFullAlertAt  DateTime?
  irrigationMethod String // flood | furrow | sprinkler | drip
  isSynthetic      Boolean       @default(false)
  dataConsent      Boolean       @default(true)
  createdAt        DateTime      @default(now())
  ownerId          String?
  owner            User?         @relation("FarmOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  installerId      String?
  installer        User?         @relation("FarmInstaller", fields: [installerId], references: [id], onDelete: SetNull)
  pumps            Pump[]
  dailyRecords     DailyRecord[]
  advisories       Advisory[]
  chatMessages     ChatMessage[]
  fieldChecks      FieldCheck[]
  soilReadings     SoilReading[]
  devices          Device[]
}

model Pump {
  id               String             @id @default(cuid())
  farmId           String
  farm             Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  ratedKw          Float
  pvKwp            Float
  staticDepthFt    Float // depth to water level (NOT bore depth)
  boreDepthFt      Float?
  drawdownM        Float              @default(3)
  efficiency       Float              @default(0.4) // wire-to-water
  calibrated       Boolean            @default(false)
  hasTelemetry     Boolean            @default(false)
  /// Local date (YYYY-MM-DD) of the last "pump ran too long" SMS, so it is sent at most once a day.
  lastOverrunAlert String?
  /// Remote start/stop. Switched on when a SIM control box (fitted by a qualified electrician) is linked to this farm.
  controlEnabled   Boolean            @default(false)
  desiredOn        Boolean            @default(false)
  /// Hard stop: the pump must be off by this time whatever else happens. The control box enforces it on its own clock.
  offAt            DateTime?
  /// Stop (never start) automatically when a soil probe shows enough water.
  autoStopWhenFull Boolean            @default(false)
  /// What the control box last reported, and when it last spoke to the server.
  deviceOn         Boolean?
  deviceSeenAt     DateTime?
  controlLog       PumpControlLog[]
  telemetry        TelemetryReading[]
}

/// A SIM device: a soil probe or a pump control box. Each is made with a claim code printed on the box and a secret flashed into
/// its firmware. The farmer types the code once to link it to a farm; after that the device reports by itself over 2G, 3G or 4G,
/// wherever the farmer is.
model Device {
  id         String    @id @default(cuid())
  /// "probe" | "pump"
  kind       String
  /// Claim code printed on the box, for example PP-7K3Q-9M2X.
  code       String    @unique
  /// SHA-256 of the secret in the firmware. The secret itself is never stored.
  secretHash String    @unique
  farmId     String?
  farm       Farm?     @relation(fields: [farmId], references: [id], onDelete: SetNull)
  pairedAt   DateTime?
  /// User id of whoever linked it.
  pairedBy   String?
  lastSeenAt DateTime?
  /// Network the device last used, as it reports it: "2G", "3G" or "4G".
  network    String?
  /// Signal quality 0-31 (the modem's CSQ), if reported.
  signal     Int?
  createdAt  DateTime  @default(now())

  @@index([farmId])
}

/// Audit trail of every start, stop and automatic stop.
model PumpControlLog {
  id     String   @id @default(cuid())
  pumpId String
  pump   Pump     @relation(fields: [pumpId], references: [id], onDelete: Cascade)
  at     DateTime @default(now())
  /// "farmer" | "installer" | "auto-full" | "timer" | "device"
  actor  String
  /// "start" | "stop" | "auto-stop-on" | "auto-stop-off" | "enable" | "disable"
  action String
  detail String?

  @@index([pumpId, at])
}

model TelemetryReading {
  id          String   @id @default(cuid())
  pumpId      String
  pump        Pump     @relation(fields: [pumpId], references: [id], onDelete: Cascade)
  timestamp   DateTime
  powerKw     Float
  frequencyHz Float

  @@index([pumpId, timestamp])
}

/// Optional soil probe reading (moisture, temperature, salinity, indicative nutrients) sent to POST /api/soil.
model SoilReading {
  id             String   @id @default(cuid())
  farmId         String
  farm           Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  deviceId       String?
  timestamp      DateTime
  /// Volumetric water content, percent.
  moisturePct    Float
  temperatureC   Float?
  /// Bulk electrical conductivity, dS/m (salinity indicator).
  ecDsM          Float?
  nitrogenMgKg   Float?
  phosphorusMgKg Float?
  potassiumMgKg  Float?
  /// "sensor" | "simulator" | "manual"
  source         String   @default("sensor")

  @@index([farmId, timestamp])
}

model DailyRecord {
  id               String   @id @default(cuid())
  farmId           String
  farm             Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  date             DateTime // local date at 00:00 Asia/Karachi stored as UTC instant
  actualHours      Float // pump hours actually run (farmer-reported or telemetry)
  /// True once the farmer (or the drive's telemetry) gave this day's hours. Records the daily job or the advice
  /// route create ahead of time hold 0 hours as a placeholder and must not hide the "how many hours?" question.
  hoursReported    Boolean  @default(false)
  // Engine outputs (filled from Milestone 2 onwards)
  et0              Float?
  etc              Float?
  rainMm           Float?
  depletionMm      Float?
  needM3           Float?
  pumpedM3         Float?
  recommendedHours Float?
  excessM3         Float?
  wastedKwh        Float?
  pvKwh            Float?
  spareKwh         Float?

  @@unique([farmId, date])
}

model Advisory {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  date          DateTime
  textUrdu      String
  textRomanUrdu String
  textEnglish   String
  audioUrl      String?
  sentVia       String   @default("app") // app | whatsapp | cron
  createdAt     DateTime @default(now())

  @@index([farmId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
}
