    "db:reset": "prisma migrate reset --force",
    "simulate": "tsx scripts/simulate-telemetry.ts",
    "water:chart": "tsx scripts/water-chart.ts",
    "simulate:soil": "tsx scripts/simulate-soil.ts",
    "simulate:pump": "tsx scripts/simulate-pump-device.ts",
    "simulate:reset": "tsx scripts/simulate-telemetry.ts --reset",
    "demo:reset": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx scripts/seed-if-empty.ts && next build",
    "render-build": "prisma generate && prisma migrate deploy && tsx scripts/seed-if-empty.ts && next build",
    "weather:prime": "tsx scripts/prime-weather.ts"
  },
  "dependencies": {
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.75.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
