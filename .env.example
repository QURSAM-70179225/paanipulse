# Database: PostgreSQL. On Neon, DATABASE_URL = pooled URL ("-pooler" host), DIRECT_URL = direct (unpooled) URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Sign-in sessions: any long random string (e.g. `openssl rand -base64 32`)
AUTH_SECRET=
AUTHORITY_INVITE_CODE=   # authority/lender accounts need this code to sign up
TELEMETRY_INGEST_KEY=    # optional: pump drives / simulator must send it as x-ingest-key

GROQ_API_KEY=            # AI chat + Urdu voice input (fallback: rule-based answers)
GROQ_MODEL=openai/gpt-oss-120b   # any Groq model with tool calling
AZURE_SPEECH_KEY=        # optional Urdu neural voice
AZURE_SPEECH_REGION=     # optional, e.g. centralindia (closest to Pakistan)
CRON_SECRET=             # protects the daily advisory job (Vercel sends it automatically)
WEATHER_CACHE_MINUTES=30  # optional: how long live weather is reused before asking Open-Meteo again
OPEN_METEO_BASE_URL=     # optional: self-hosted Open-Meteo
OPENWEATHER_API_KEY=      # optional backup weather provider (openweathermap.org free plan); used only if Open-Meteo fails
OPEN_METEO_API_KEY=      # not needed for the free, non-commercial tier; only for a commercial Open-Meteo plan
DEMO_MODE=true           # use offline sample weather if Open-Meteo is unreachable or rate-limited
RESEND_API_KEY=          # optional: password-reset emails (resend.com free tier)
EMAIL_FROM=              # e.g. "PaaniPulse <noreply@yourdomain.com>"
APP_URL=                 # public URL used in emails, e.g. https://paanipulse.onrender.com
TWILIO_ACCOUNT_SID=      # optional: SMS / WhatsApp codes for farmers who forgot their PIN (twilio.com)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=             # sender number "+1…", or a WhatsApp sender "whatsapp:+14155238886"
SUPPORT_WHATSAPP=        # optional: WhatsApp for the forgot-PIN page and device help (falls back to SUPPORT_PHONE), e.g. 923001234567
SUPPORT_PHONE=          # optional: team number shown to farmers with no device yet (Call button)
