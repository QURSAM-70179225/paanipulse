DATABASE_URL="file:./dev.db"
GROQ_API_KEY=            # needed for AI chat (fallback: rule-based answers)
GROQ_MODEL=openai/gpt-oss-120b   # any Groq model with tool calling
AZURE_SPEECH_KEY=        # optional (fallback: cached mp3 / browser TTS / text)
AZURE_SPEECH_REGION=     # optional, e.g. centralindia (closest to Pakistan)
DEMO_MODE=true           # use cached weather if Open-Meteo is unreachable or rate-limited
